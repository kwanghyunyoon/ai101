---
import "../styles/global.css";
import { SITE_TITLE, SITE_TAGLINE } from "../consts";
import { DEFAULT_LANGUAGE, getLanguage, liveLanguages } from "../i18n/config";
import { localizePath } from "../i18n/routing";
import HreflangAlternates from "../components/HreflangAlternates.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.tsx";

interface Props {
  /** The page's language code (`en` / `ko` / `es`). */
  lang?: string;
  /** Path without the language prefix, e.g. `/lessons/what-an-llm-actually-is/`. */
  path?: string;
  title?: string;
  description?: string;
}

const {
  lang = DEFAULT_LANGUAGE,
  path = "/",
  title = SITE_TITLE,
  description = SITE_TAGLINE,
} = Astro.props;

const language = getLanguage(lang) ?? getLanguage(DEFAULT_LANGUAGE)!;
const switcherLanguages = liveLanguages();

// Set PUBLIC_CF_BEACON_TOKEN (build env / Cloudflare Pages) to enable the
// cookieless Web Analytics beacon. Absent in local dev; that is fine.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={language.htmlLang} dir={language.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a56db" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <HreflangAlternates path={path} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="app-header">
      <a class="wordmark" href={localizePath("/", lang)}>AI 101</a>
      <LanguageSwitcher
        lang={lang}
        logicalPath={path}
        languages={switcherLanguages}
        client:idle
      />
    </header>
    <main id="main" class="app-main">
      <slot />
    </main>
    <footer class="app-footer">
      <p>
        Free and open. Content licensed CC BY-SA 4.0, code licensed MIT.
        Your progress stays in your browser — no account, no cookies.
      </p>
    </footer>

    <script>
      // Register the pass-through service worker (offline precache lands later).
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* registration failure is non-fatal for the scaffold */
          });
        });
      }
    </script>

    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${beaconToken}"}`}
        />
      )
    }
  </body>
</html>
