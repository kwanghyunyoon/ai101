---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLessons } from "../../lib/lessons";
import { SITE_TITLE } from "../../consts";

// A bare Lesson index for navigation during the build-out. The real home
// screen (table of contents + progress + resume) is a later ticket.
const lessons = await getLessons();
---

<BaseLayout title={`Lessons — ${SITE_TITLE}`}>
  <h1>Lessons</h1>
  <ol class="lesson-list">
    {
      lessons.map((lesson) => (
        <li>
          <a href={`/lessons/${lesson.id}/`}>{lesson.data.title}</a>
          <span class="lesson-meta"> · about {lesson.data.minutes} min</span>
        </li>
      ))
    }
  </ol>
</BaseLayout>
