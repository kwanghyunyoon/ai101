---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CompletionGuard from "../../../components/CompletionGuard.tsx";
import { getLessons, lessonRoutes } from "../../../lib/lessons";
import { liveLanguages } from "../../../i18n/config";
import { lessonPath, localizePath } from "../../../i18n/routing";
import { ui, fmt } from "../../../i18n/ui";

// The completion screen. Reached from the home button and the end-of-Lesson
// action once every Lesson is complete (the resume point becomes this page).
// CompletionGuard sends an unfinished Learner back to their resume point.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const t = ui(lang);
const lessons = await getLessons(lang);
const { lessonIds, hrefs } = lessonRoutes(lessons, lang);
const homeHref = localizePath("/", lang);

// "Revisit the mental-model lesson" points at Lesson 3 when it exists, and
// otherwise the last Lesson, so this page works while the Course is built out.
const revisit = lessons.find((l) => l.data.order === 3) ?? lessons.at(-1)!;
---

<BaseLayout lang={lang} path="/done/" title={t.done.pageTitle}>
  <CompletionGuard
    lessonIds={lessonIds}
    hrefs={hrefs}
    homeHref={homeHref}
    client:load
  />

  <h1>{t.done.heading}</h1>
  <p>{t.done.body}</p>

  <h2>{t.done.nextHeading}</h2>
  <ul>
    <li>
      <a href={lessonPath(revisit.slug, lang)}>
        {fmt(t.done.revisit, { title: revisit.data.title })}</a>. {t.done.revisitNote}
    </li>
    <li>{t.done.practice}</li>
  </ul>

  <p><a href={homeHref}>{t.done.back}</a></p>
</BaseLayout>
