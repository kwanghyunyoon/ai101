---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CompletionGuard from "../../../components/CompletionGuard.tsx";
import { SITE_TITLE } from "../../../consts";
import { getLessons } from "../../../lib/lessons";
import { liveLanguages } from "../../../i18n/config";
import { lessonPath, localizePath } from "../../../i18n/routing";

// The completion screen. Reached from the home button and the end-of-Lesson
// action once every Lesson is complete (the resume point becomes this page).
// CompletionGuard sends an unfinished Learner back to their resume point.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const lessons = await getLessons();
const lessonIds = lessons.map((l) => l.id);
const hrefs = Object.fromEntries(lessons.map((l) => [l.id, lessonPath(l.id, lang)]));
const homeHref = localizePath("/", lang);

// "Revisit the mental-model lesson" points at Lesson 3 when it exists, and
// otherwise the last Lesson, so this page works while the Course is built out.
const revisit = lessons.find((l) => l.data.order === 3) ?? lessons.at(-1)!;
---

<BaseLayout lang={lang} path="/done/" title={`You finished — ${SITE_TITLE}`}>
  <CompletionGuard
    lessonIds={lessonIds}
    hrefs={hrefs}
    homeHref={homeHref}
    client:load
  />

  <h1>You finished AI 101</h1>
  <p>
    You worked through every lesson. You now have a working picture of what a
    large language model does and where it fails. You can also get better answers
    out of one. That was the goal.
  </p>

  <h2>Where to go next</h2>
  <ul>
    <li>
      <a href={lessonPath(revisit.id, lang)}>Revisit {revisit.data.title}</a>.
      The mental-model lesson rewards a second read.
    </li>
    <li>
      Go practice in a tool you picked. Use ChatGPT, Gemini, Claude, or Grok for
      everyday help. Use Perplexity when you need sources. Bring a real task and
      try the before/after prompt from the lessons.
    </li>
  </ul>

  <p><a href={homeHref}>Back to the lesson list</a></p>
</BaseLayout>
