---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeProgress from "../../components/HomeProgress.tsx";
import { SITE_TITLE, SITE_TAGLINE } from "../../consts";
import { getLessons } from "../../lib/lessons";
import { liveLanguages } from "../../i18n/config";
import { localizePath } from "../../i18n/routing";

// One home per live language. A configured-but-not-live language (ko, es) is
// simply absent from this list, so no route is generated and the build passes.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const lessons = await getLessons();
const doneHref = localizePath("/done/", lang);

const links = lessons.map((lesson) => ({
  id: lesson.id,
  title: lesson.data.title,
  minutes: lesson.data.minutes,
  href: localizePath(`/lessons/${lesson.id}/`, lang),
}));
---

<BaseLayout lang={lang} path="/" title={SITE_TITLE}>
  <h1>{SITE_TITLE}</h1>
  <p>{SITE_TAGLINE}</p>
  <p>
    {lessons.length} short lessons with a knowledge check after each. Your
    progress stays in this browser — start anywhere, come back anytime.
  </p>

  <HomeProgress lessons={links} doneHref={doneHref} client:only="preact" />

  <noscript>
    <ol class="lesson-list">
      {
        links.map((lesson) => (
          <li>
            <a href={lesson.href}>{lesson.title}</a>
            <span class="lesson-meta"> · about {lesson.minutes} min</span>
          </li>
        ))
      }
    </ol>
  </noscript>
</BaseLayout>
