---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeProgress from "../../components/HomeProgress.tsx";
import { SITE_TITLE } from "../../consts";
import { getLessons } from "../../lib/lessons";
import { liveLanguages } from "../../i18n/config";
import { lessonPath, localizePath } from "../../i18n/routing";
import { ui, fmt } from "../../i18n/ui";

// One home per live language. A configured-but-not-live language (ko, es) is
// simply absent from this list, so no route is generated and the build passes.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const t = ui(lang);
const lessons = await getLessons(lang);
const doneHref = localizePath("/done/", lang);

const links = lessons.map((lesson) => ({
  id: lesson.slug,
  title: lesson.data.title,
  minutes: lesson.data.minutes,
  href: lessonPath(lesson.slug, lang),
}));
---

<BaseLayout lang={lang} path="/" title={SITE_TITLE}>
  <h1>{SITE_TITLE}</h1>
  <p>{t.home.tagline}</p>
  <p>{fmt(t.home.lessonsIntro, { count: lessons.length })}</p>

  <HomeProgress lessons={links} doneHref={doneHref} lang={lang} client:load />
</BaseLayout>
