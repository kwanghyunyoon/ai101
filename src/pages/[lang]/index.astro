---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_TAGLINE } from "../../consts";
import { liveLanguages } from "../../i18n/config";

// One home per live language. A configured-but-not-live language (ko, es) is
// simply absent from this list, so no route is generated and the build passes.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
---

<BaseLayout lang={lang} path="/" title={`${SITE_TITLE} — coming soon`}>
  <h1>{SITE_TITLE}</h1>
  <p>{SITE_TAGLINE}</p>
  <p>
    A course on how AI and large language models actually work — written for
    curious adults, finishable in about 40 minutes.
  </p>
  <p>
    The Course is being built in the open. Six short lessons, a knowledge check
    after each, and honest guidance on which tools to use. No signup, no cost.
  </p>
  <p><strong>Check back soon.</strong></p>
</BaseLayout>
