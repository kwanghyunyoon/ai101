---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLessons } from "../../../lib/lessons";
import { liveLanguages } from "../../../i18n/config";
import { localizePath } from "../../../i18n/routing";
import { ui, fmt } from "../../../i18n/ui";

// A bare Lesson index for navigation during the build-out. The real home
// screen (table of contents + progress + resume) is a later ticket.
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const t = ui(lang);
const lessons = await getLessons(lang);
---

<BaseLayout lang={lang} path="/lessons/" title={t.lessons.pageTitle}>
  <h1>{t.lessons.title}</h1>
  <ol class="lesson-list">
    {
      lessons.map((lesson) => (
        <li>
          <a href={localizePath(`/lessons/${lesson.slug}/`, lang)}>
            {lesson.data.title}
          </a>
          <span class="lesson-meta">
            {" "}
            {fmt(t.lessons.meta, { minutes: lesson.data.minutes })}
          </span>
        </li>
      ))
    }
  </ol>
</BaseLayout>
