---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../../../consts";
import { liveLanguages } from "../../../i18n/config";

// The privacy note: one screen, plain language, linked from the footer on every
// page. One per live language (ko, es are absent until they go live).
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
---

<BaseLayout lang={lang} path="/privacy/" title={`What we store — ${SITE_TITLE}`}>
  <h1>What we store</h1>
  <p>
    This site has no account and no login. You do not give us your name or email.
    Here is everything the site keeps, and where it keeps it.
  </p>

  <h2>Saved in your browser</h2>
  <p>Two small things are saved on your own device, so the site works the way you left it:</p>
  <ul>
    <li>Which lessons you have finished. This drives the "done" count and where you pick back up.</li>
    <li>Your language choice, so the site opens in that language next time.</li>
  </ul>
  <p>
    Both live in local storage — a small space your browser keeps for this site.
    They never leave your device and we cannot see them. Clearing your browser
    data erases them, and nothing breaks if you do.
  </p>

  <h2>What we do not do</h2>
  <ul>
    <li>No account, no password, no login.</li>
    <li>No cookies.</li>
    <li>No selling or sharing of data. There is no data to sell.</li>
    <li>No tracking of you across other sites.</li>
  </ul>

  <h2>Visitor counts</h2>
  <p>
    We use Cloudflare Web Analytics to see how the site is used. It shows
    aggregate numbers only: how many times each page loaded, which sites link
    here, and roughly which countries visitors come from.
  </p>
  <p>
    It sets no cookies. It does not build a profile of you and does not track you
    across other sites.
  </p>

  <h2>Questions</h2>
  <p>
    The code is open source. You can read exactly what it does, or open an issue,
    on <a href="https://github.com/kwanghyunyoon/ai101">GitHub</a>.
  </p>
</BaseLayout>
