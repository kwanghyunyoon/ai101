---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { liveLanguages } from "../../../i18n/config";
import { ui } from "../../../i18n/ui";

// The privacy note: one screen, plain language, linked from the footer on every
// page. One per live language (ko, es are absent until they go live).
export function getStaticPaths() {
  return liveLanguages().map((lang) => ({ params: { lang: lang.code } }));
}

const { lang } = Astro.params;
const t = ui(lang).privacy;
const [questionsBefore, questionsAfter] = t.questionsBody.split("{link}");
---

<BaseLayout lang={lang} path="/privacy/" title={t.pageTitle}>
  <h1>{t.heading}</h1>
  <p>{t.intro}</p>

  <h2>{t.storedHeading}</h2>
  <p>{t.storedIntro}</p>
  <ul>
    <li>{t.storedLessons}</li>
    <li>{t.storedLanguage}</li>
  </ul>
  <p>{t.storedNote}</p>

  <h2>{t.notHeading}</h2>
  <ul>
    <li>{t.notAccount}</li>
    <li>{t.notCookies}</li>
    <li>{t.notSelling}</li>
    <li>{t.notTracking}</li>
  </ul>

  <h2>{t.analyticsHeading}</h2>
  <p>{t.analyticsBody}</p>
  <p>{t.analyticsNote}</p>

  <h2>{t.questionsHeading}</h2>
  <p>
    {questionsBefore}<a href="https://github.com/kwanghyunyoon/ai101"
      >{t.questionsLink}</a
    >{questionsAfter}
  </p>
</BaseLayout>
